[Unit]
Description=SYZYGY Withings health workbook sync
After=network-online.target syzygy-health-workbook.service
Wants=network-online.target

[Service]
Type=oneshot
User=KA_PI
WorkingDirectory=/home/KA_PI/syzygy-mission-control
Environment=HEALTH_WORKBOOK_URL=http://127.0.0.1:5052
Environment=WITHINGS_ENV_FILE=/home/KA_PI/syzygy-runtime/withings.env
EnvironmentFile=-/home/KA_PI/syzygy-runtime/health-workbook.env
EnvironmentFile=-/home/KA_PI/syzygy-runtime/withings.env
ExecStart=/bin/bash /home/KA_PI/syzygy-mission-control/scripts/run-withings-sync.sh
NoNewPrivileges=true
