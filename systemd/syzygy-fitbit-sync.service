[Unit]
Description=SYZYGY Fitbit health workbook sync
After=network-online.target syzygy-health-workbook.service
Wants=network-online.target

[Service]
Type=oneshot
User=KA_PI
WorkingDirectory=/home/KA_PI/syzygy-mission-control
Environment=HEALTH_WORKBOOK_URL=http://127.0.0.1:5052
Environment=FITBIT_MCP_URL=http://127.0.0.1:8010/mcp
EnvironmentFile=-/home/KA_PI/syzygy-runtime/health-workbook.env
ExecStart=/bin/bash /home/KA_PI/syzygy-mission-control/scripts/run-fitbit-sync.sh
NoNewPrivileges=true
