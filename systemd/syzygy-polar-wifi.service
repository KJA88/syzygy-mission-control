[Unit]
Description=SYZYGY Polar capture Wi-Fi helper
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/KA_PI/syzygy-mission-control
Environment=POLAR_WIFI_USER=KA_PI
Environment=POLAR_WIFI_SOCKET=/run/syzygy-polar-wifi/control.sock
ExecStart=/usr/bin/python3 -m control.polar_wifi
RuntimeDirectory=syzygy-polar-wifi
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/syzygy-polar-wifi
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
